{
  "name": "rov-overlay-tool",
  "version": "2.0.2",
  "description": "Arena of Valor Draft Pick Overlay Tool",
  "main": "electron-main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "node tools/check-web-types.js",
    "start": "npm run build && node server.js",
    "serve": "npm run build && node server.js",
    "app": "npm run build && electron .",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "portable": "npm run build && electron-builder --win portable --x64",
    "dev": "nodemon --watch server -e ts --exec \"npm run build && node server.js\"",
    "check": "node tools/check-syntax.js",
    "test": "npm run build && node --test \"build/tests/**/*.test.js\"",
    "check-heroes": "node check-heroes.js"
  },
  "keywords": [
    "rov",
    "arena of valor",
    "overlay",
    "draft pick"
  ],
  "author": "LazyAF",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.1.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^2.0.22",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.rov.overlay.tool",
    "productName": "ROV Overlay Tool",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "public/images/sounds/**"
    ],
    "files": [
      "electron-main.js",
      "server.js",
      "build/server/**/*",
      "LICENSE.md",
      "LICENSE.txt",
      "package.json",
      "public/**/*",
      "data/**/*",
      "!data/state.json",
      "!data/presets.json",
      "!data/tournament.db*",
      "!public/images/team-logos/*.png",
      "!public/images/team-logos/*.jpg",
      "!public/images/team-logos/*.webp",
      "!public/images/skins/*.png",
      "!public/images/skins/*.jpg",
      "!public/images/skins/*.webp",
      "node_modules/**/*"
    ],
    "win": {
      "icon": "public/images/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/images/app-icon.ico",
      "uninstallerIcon": "public/images/app-icon.ico",
      "license": "LICENSE.txt"
    },
    "portable": {
      "artifactName": "ROV-Overlay-Tool-Portable.exe"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
